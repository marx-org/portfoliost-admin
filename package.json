{
  "name": "portfoliost-admin",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "gen:types": "openapi-typescript node_modules/@marx2/contracts/openapi.yaml -o src/generated/api-types.d.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/busboy": "^1.5.4",
    "busboy": "^1.6.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "jose": "^6.2.9",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@marx2/contracts": "^1.6.15",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.13.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0"
  }
}
